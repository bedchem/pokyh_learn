# Public deployment metadata. This URL is used only for metadata and redirects.
NEXT_PUBLIC_SITE_URL=https://learn.pokyh.com

# Server-to-server connection to the existing Pokyh API. Never prefix secrets
# with NEXT_PUBLIC_. In production this must resolve to api.pokyh.com.
API_BACKEND_URL=https://api.pokyh.com
API_BACKEND_KEY=replace-with-the-server-only-pokyh-api-key

# Cookie/session policy. Generate a random value of at least 32 bytes.
LEARN_SESSION_COOKIE_NAME=pokyh_learn_session
LEARN_REFRESH_COOKIE_NAME=pokyh_learn_refresh
LEARN_CSRF_COOKIE_NAME=pokyh_learn_csrf
# Public cookie-name metadata only; it lets the browser echo the CSRF token.
NEXT_PUBLIC_LEARN_CSRF_COOKIE_NAME=pokyh_learn_csrf
LEARN_COOKIE_DOMAIN=

# API routing and local-only UX mode. Demo mode is deliberately off by default.
LEARN_API_PREFIX=/learn
NEXT_PUBLIC_LEARN_DEMO_MODE=false

# Optional request deadline for the BFF to the API, in milliseconds.
LEARN_API_TIMEOUT_MS=8000
